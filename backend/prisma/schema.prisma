// ── Templates de Landing (Factory) ────────────────────────────────────
model LandingTemplate {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  previewUrl  String?
  config      Json     @default("{}") // Configuració global del template
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sections    LandingTemplateSection[]

  @@index([slug])
  @@map("landing_templates")
}

model LandingTemplateSection {
  id          String   @id @default(uuid())
  templateId  String
  kind        String   // ex: "HERO", "FEATURES", "CTA", "TEXT"
  title       String?
  config      Json     @default("{}")
  orderIndex  Int

  template    LandingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("landing_template_sections")
}

// ── Configuració de Facturació externa (Holded, etc) ──────────────────
model BillingProviderConfig {
  id          String   @id @default(uuid())
  clientId    String?  // Opcional: si és null és la global
  provider    String   // ex: "holded"
  apiKeyEnc   String
  iv          String
  tag         String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
  @@map("billing_provider_configs")
}

